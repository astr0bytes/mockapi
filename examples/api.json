{
  "headers": {
    "X-Powered-By": "mockapi"
  },
  "routes": [
    {
      "method": "GET",
      "path": "/health",
      "body": {"status": "ok"}
    },
    {
      "method": "GET",
      "path": "/users",
      "body_file": "users.json"
    },
    {
      "method": "GET",
      "path": "/users/{id}",
      "body": {"id": "{{params.id}}", "name": "User {{params.id}}", "lang": "{{query.lang}}"}
    },
    {
      "method": "POST",
      "path": "/users",
      "status": 201,
      "headers": {"Location": "/users/42"},
      "body": {"id": 42, "created": true}
    },
    {
      "method": "DELETE",
      "path": "/users/{id}",
      "status": 204
    },
    {
      "method": "GET",
      "path": "/slow",
      "delay_ms": 2000,
      "body": {"message": "slow response"}
    },
    {
      "method": "GET",
      "path": "/error",
      "status": 503,
      "body": {"error": "service unavailable"}
    },
    {
      "method": "POST",
      "path": "/echo/*",
      "echo": true
    }
  ]
}
